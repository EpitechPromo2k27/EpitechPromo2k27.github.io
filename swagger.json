{
  "openapi": "3.0.0",
  "info": {
    "title": "My API",
    "version": "1.0.0",
    "description": "API documentation"
  },
  "paths": {
    "/items": {
      "get": {
        "description": "Retreive items from database",
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      },
      "post": {
        "description": "Add an item to the database",
        "responses": {
          "200": {
            "description": "Successfully added an item to the database"
          },
          "400": {
            "description": "Request validation failed"
          }
        }
      }
    },
    "/items/{id}": {
      "put": {
        "description": "Change an item in the database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Item ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully modified an item from the database"
          },
          "400": {
            "description": "Request validation failed"
          },
          "404": {
            "description": "Item not found"
          }
        }
      },
      "delete": {
        "description": "Remove an item from the database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Item ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully removed an item from the database"
          },
          "404": {
            "description": "Item not found"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "description": "Register a new user account",
        "responses": {
          "201": {
            "description": "Account created"
          },
          "400": {
            "description": "Request validation failed"
          },
          "409": {
            "description": "Email or username already taken"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Log in and start a session",
        "responses": {
          "200": {
            "description": "Authenticated, session cookie set"
          },
          "400": {
            "description": "Request validation failed"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Log out and invalidate the current session, if any",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "description": "Return the currently authenticated user",
        "responses": {
          "200": {
            "description": "The authenticated user"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}

{
  "openapi": "3.0.0",
  "info": {
    "title": "My API",
    "version": "1.0.0",
    "description": "API documentation"
  },
  "paths": {
    "/tasks/legacy": {
      "get": {
        "description": "Retrieve all legacy tasks from database",
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      }
    },
    "/tasks/legacy/{id}": {
      "get": {
        "description": "Retrieve a legacy task from database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Legacy Task ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      },
      "post": {
        "description": "Copy a legacy task to the database",
        "requestBody": {
          "description": "Task data to add to the copied legacy task",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectId",
                  "priority"
                ],
                "properties": {
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "deadline": {
                    "type": "date",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully copied the legacy task to the database"
          },
          "400": {
            "description": "Request validation failed"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "description": "Retrieve tasks from database",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      },
      "post": {
        "description": "Add a task to the database",
        "requestBody": {
          "description": "Task data to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projectId",
                  "title",
                  "status",
                  "priority"
                ],
                "properties": {
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "TODO",
                      "IN_PROGRESS",
                      "DONE"
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "deadline": {
                    "type": "date",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully added a task to the database"
          },
          "400": {
            "description": "Request validation failed"
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "description": "Retrieve a task from database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Task ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      },
      "put": {
        "description": "Change a task in the database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Task ID"
          }
        ],
        "requestBody": {
          "description": "Task data to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "status",
                  "priority"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "TODO",
                      "IN_PROGRESS",
                      "DONE"
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "deadline": {
                    "type": "date",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully modified a task from the database"
          },
          "400": {
            "description": "Request validation failed"
          },
          "404": {
            "description": "Task not found"
          }
        }
      },
      "delete": {
        "description": "Remove a task from the database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Task ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully removed a task from the database"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "description": "Retrieve all projects of a user from database",
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      },
      "post": {
        "description": "Add a project to the database",
        "requestBody": {
          "description": "Project data to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully added a project to the database"
          },
          "400": {
            "description": "Request validation failed"
          }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "description": "Retrieve a project from database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Database interaction successfull"
          }
        }
      },
      "put": {
        "description": "Modify a project in the database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project ID"
          }
        ],
        "requestBody": {
          "description": "Project data to update",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully modified a project from the database"
          },
          "400": {
            "description": "Request validation failed"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "delete": {
        "description": "Delete a project from the database",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Project ID"
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted the project from the database"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "description": "Register a new user account",
        "responses": {
          "201": {
            "description": "Account created"
          },
          "400": {
            "description": "Request validation failed"
          },
          "409": {
            "description": "Email or username already taken"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Log in and start a session",
        "responses": {
          "200": {
            "description": "Authenticated, session cookie set"
          },
          "400": {
            "description": "Request validation failed"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Log out and invalidate the current session, if any",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "description": "Return the currently authenticated user",
        "responses": {
          "200": {
            "description": "The authenticated user"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/account": {
      "get": {
        "description": "View the authenticated user's account",
        "responses": {
          "200": {
            "description": "The account"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "patch": {
        "description": "Update username, email and/or password. currentPassword is required when changing email or password.",
        "responses": {
          "200": {
            "description": "Updated account"
          },
          "400": {
            "description": "Request validation failed"
          },
          "401": {
            "description": "Not authenticated, or currentPassword incorrect/missing"
          },
          "409": {
            "description": "Username or email already taken"
          }
        }
      }
    },
    "/account/deletion-request": {
      "post": {
        "description": "Request deletion of the authenticated user's account (GDPR).\nThis does not delete the account immediately: it records the\nrequest for processing and freezes the account (all sessions,\nincluding the current one, are invalidated).\n",
        "responses": {
          "201": {
            "description": "Deletion request recorded"
          },
          "401": {
            "description": "Not authenticated, or password incorrect"
          },
          "409": {
            "description": "A deletion request is already pending"
          }
        }
      },
      "delete": {
        "description": "Cancel a pending account deletion request",
        "responses": {
          "204": {
            "description": "Deletion request cancelled"
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "No pending deletion request"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}
